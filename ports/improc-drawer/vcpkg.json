{
  "name": "improc-drawer",
  "version-string": "d4ec359ca6c5feb326c224f1ed7e0848744c63e2",
  "homepage": "https://github.com/pirlruc/drawer/",
  "description": "Image processing drawer library",
  "license": "MIT",
  "dependencies": [
    {
      "name" : "vcpkg-cmake",
      "host" : true
    },
    {
      "name" : "vcpkg-cmake-config",
      "host" : true
    },
    {
      "name": "improc-corecv",
      "version>=": "6ce167305c824d9568a46c86e4e6746df2882809"
    }
  ],
  "features": {
    "text": {
      "description": "Support text generation",
      "dependencies": [
        {
          "name": "freetype",
          "version>=": "2.13.2",
          "features": ["bzip2","zlib","png","error-strings","subpixel-rendering"]
        }
      ]
    },
    "tests": {
      "description": "Support test library",
      "dependencies": [
        {
          "name": "gtest",
          "version>=": "1.15.2"
        }
      ]
    }
  }
}