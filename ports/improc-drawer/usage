improc-drawer provides CMake targets:

    # For compilation using manifest mode
    set(OpenCV_DIR ${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/share/opencv4)
    find_package(OpenCV REQUIRED)
    
    find_package(improc-drawer CONFIG REQUIRED)
    target_link_libraries(main PRIVATE improc::improc-drawer)
    