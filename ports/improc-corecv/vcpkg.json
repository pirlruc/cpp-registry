{
  "name": "improc-corecv",
  "version-string": "3e98d0b908f530fc091cee49082e70edc3ed690d",
  "description": "Image processing core computer vision library",
  "homepage": "https://github.com/pirlruc/corecv/",
  "license": "MIT",
  "dependencies": [
    {
      "name": "improc-services",
      "version>=": "7825e3f13a8f43ab445ed14cc9e2bdbe62d50931"
    },
    {
      "name": "opencv",
      "default-features": false,
      "features": [
        "jpeg",
        "opencl",
        "opengl",
        "openmp",
        "png",
        "thread",
        "tiff"
      ],
      "platform": "!windows",
      "version>=": "4.11.0"
    },
    {
      "name": "opencv",
      "default-features": false,
      "features": [
        "jpeg",
        "opencl",
        "opengl",
        "openmp",
        "png",
        "thread",
        "tiff"
      ],
      "platform": "windows & mingw",
      "version>=": "4.11.0"
    },
    {
      "name": "opencv",
      "default-features": false,
      "features": [
        "ipp",
        "jpeg",
        "opencl",
        "opengl",
        "openmp",
        "png",
        "tbb",
        "thread",
        "tiff"
      ],
      "platform": "windows & !mingw",
      "version>=": "4.11.0"
    },
    {
      "name": "vcpkg-cmake",
