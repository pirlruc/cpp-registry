    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "tests": {
      "description": "Support test library",
      "dependencies": [
        {
          "name": "gtest",
          "version>=": "1.17.0"
        }
      ]
    }
  }
}
